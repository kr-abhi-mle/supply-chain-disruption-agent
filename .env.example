# Optional. Without this file (or without a key) the system runs offline:
# a rule-based parser and template emails, with exactly the same numbers.
# Copy to .env and add a free key from https://aistudio.google.com/apikey to use Gemini.
# One line, no space at the start, no spaces around =, nothing after the key.
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the main model is rate-limited (429) or down. Free-tier quotas are per model.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# "gemini" or "offline". Leave empty to use Gemini whenever a key is set.
LLM_MODE=
